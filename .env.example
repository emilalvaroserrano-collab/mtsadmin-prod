# Copy to .env and fill in the values you use.
# Environment values win over the same settings saved in the admin UI.
# Do not commit real secrets.

# --- Database (Neon on Vercel) ---
# Leave unset in local preview. The app then uses a built-in database.
# On Vercel, any one of these is enough. Migrations prefer the unpooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# --- Auth ---
# Set to false to skip sign-in and use the local dev user.
VITE_AUTH_ENABLED=true
# Used only when the staff table is empty. Does nothing once an owner exists.
BOOTSTRAP_OWNER_EMAIL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://mts.192-888-702-801.site
# Auth0 callback: https://your-domain.example/api/auth/oauth2/callback/auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_MANAGEMENT_API_CLIENT_ID=
AUTH0_MANAGEMENT_API_CLIENT_SECRET=
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# --- Zendesk Support ---
# Ticket read and write need ZENDESK_EMAIL plus ZENDESK_API_TOKEN.
ZENDESK_SUBDOMAIN=mts-portal
ZENDESK_OAUTH_CLIENT_ID=mts-portal
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SCOPES=read write
ZENDESK_OAUTH_TOKEN_URL=https://mts-portal.zendesk.com/oauth/tokens
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Set to 0 to pause Sarah's action recovery sweep.
SARAH_ACTION_ENGINE=1
XAI_API_KEY=

# --- Zendesk Conversations ---
ZENDESK_CONVERSATIONS_APP_ID=
ZENDESK_CONVERSATIONS_KEY_ID=
ZENDESK_CONVERSATIONS_SECRET=
# Point Zendesk at https://your-domain/api/zendesk/webhook
ZENDESK_WEBHOOK_ID=
ZENDESK_WEBHOOK_SECRET=
ZENDESK_EVENT_WEBHOOK_ID=
ZENDESK_EVENT_WEBHOOK_SECRET=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# sandbox or live. Leave the API base empty to use the default for that mode.
ALTERNATIVE_ENV=sandbox
ALTERNATIVE_CLIENT_ID=
ALTERNATIVE_CLIENT_SECRET=
ALTERNATIVE_API_BASE=https://public-api.demo.alternativepayments.io
ALTERNATIVE_WEBHOOK_SECRET=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=Manage Tech Service <noreply@managetechservice.com>

# --- UPS tracking ---
# Leave UPS_ENV unset for the live API. Set sandbox only for CIE test labels.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ENV=production

# --- MTS Agent ---
# Used when OpenRouter has no key saved in the admin portal.
OPENROUTER_API_KEY=
# Read-aloud voice for MTS Agent chat lines. The key stays on the server.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Fola
# ElevenLabs read-aloud. Voice JBFqnCBsd6RMkjVDRZzb is the default from the API example.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4_turbo

# --- Jobs ---
# Vercel sends this as Authorization: Bearer.
CRON_SECRET=
